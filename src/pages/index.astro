  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apps Portfolio</title>
    <meta name="description" content="アプリポートフォリオ" />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Apps Portfolio</h1>
        <p class="subtitle">アプリケーション一覧</p>
