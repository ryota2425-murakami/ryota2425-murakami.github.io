        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Yu Gothic', sans-serif;
        line-height: 1.8; color: #2d3748;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        min-height: 100vh; padding: 40px 20px;
      }
      .container {
        max-width: 900px; margin: 0 auto; background: #fff;
        border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        overflow: hidden; animation: fadeIn 0.6s ease-out;
      }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
      .header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: #fff; padding: 60px 40px; text-align: center;
      }
      .header .app-name { font-size: 0.95rem; font-weight: 300; opacity: 0.85; margin-bottom: 8px; letter-spacing: 2px; text-transform: uppercase; }
      .content { padding: 50px 40px; }
      h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.5px; }
      .subtitle { font-size: 1rem; font-weight: 300; opacity: 0.9; }
      h2 {
        color: #f5576c; font-size: 1.3rem; font-weight: 600;
        margin-top: 40px; margin-bottom: 15px; padding-bottom: 10px;
        border-bottom: 2px solid #e2e8f0; position: relative;
      }
      h2::before {
        content: ''; position: absolute; bottom: -2px; left: 0;
        width: 60px; height: 2px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      }
      p { margin-bottom: 16px; font-size: 0.97rem; }
      ul { margin: 12px 0 20px 0; padding-left: 20px; }
      li { margin-bottom: 10px; font-size: 0.97rem; position: relative; padding-left: 10px; }
      li::before { content: '→'; position: absolute; left: -12px; color: #f5576c; font-weight: bold; }
      a { color: #f5576c; text-decoration: none; font-weight: 500; transition: color 0.2s ease; }
      a:hover { color: #f093fb; }
      .section {
        background: #fff5f7; padding: 28px 30px; border-radius: 12px;
        margin: 28px 0; border-left: 4px solid #f5576c;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .section:hover { transform: translateX(5px); box-shadow: 0 4px 12px rgba(245,87,108,0.15); }
      .nav-links { display: flex; gap: 16px; justify-content: center; margin-top: 12px; flex-wrap: wrap; }
      .nav-links a {
        background: rgba(255,255,255,0.2); color: #fff; padding: 6px 18px;
        border-radius: 20px; font-size: 0.88rem; border: 1px solid rgba(255,255,255,0.35);
        transition: background 0.2s ease;
      }
      .nav-links a:hover { background: rgba(255,255,255,0.35); color: #fff; }
      .footer {
        background: #fff5f7; padding: 30px 40px; text-align: center;
        color: #718096; font-size: 0.88rem; border-top: 1px solid #e2e8f0;
      }
      .footer a { font-size: 0.88rem; }
      .last-updated { font-size: 0.85rem; color: #718096; margin-top: 8px; }
      @media (max-width: 768px) {
        body { padding: 20px 10px; }
        .header { padding: 40px 24px; }
        .content { padding: 30px 24px; }
        h1 { font-size: 2rem; }
        .section { padding: 20px; }
      }
      @media (max-width: 480px) {
        h1 { font-size: 1.7rem; }
        h2 { font-size: 1.15rem; }
        p, li { font-size: 0.93rem; }
      }
    </style>
  </head>
